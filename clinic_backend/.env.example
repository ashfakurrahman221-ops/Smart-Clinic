# ==============================================================================
# SMART CLINIC BACKEND CONFIGURATION TEMPLATE
# Dual Environment: Cloud Deployment (Active) & Local Development (Commented)
# ==============================================================================

# ==============================================================================
# 1. CLOUD DEPLOYMENT CONFIGURATION (RENDER + NEON + VERCEL) - ACTIVE
# ==============================================================================
DEBUG=False
SECRET_KEY=replace-with-a-cryptographically-random-50-character-secret-key
ALLOWED_HOSTS=backend-smart-clinic.onrender.com,localhost,127.0.0.1

# Neon PostgreSQL Database (Production Branch)
DATABASE_URL=postgresql://neondb_owner:password@ep-wild-hat-azfcty50-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:password@ep-wild-hat-azfcty50.c-3.ap-southeast-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require
NEON_BRANCH=production
ALLOW_SQLITE_IN_PROD=False

# Domains and Cross-Origin Configuration
BACKEND_URL=https://backend-smart-clinic.onrender.com
FRONTEND_URL=https://final-year-project-version1.vercel.app
CORS_ALLOWED_ORIGINS=https://final-year-project-version1.vercel.app
CSRF_TRUSTED_ORIGINS=https://final-year-project-version1.vercel.app

# Production Security Headers
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# JWT Token Lifetime
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=1

# Bangladesh Payment Gateway (SSLCommerz Sandbox)
SSLCOMMERZ_IS_SANDBOX=True
SSLCOMMERZ_STORE_ID=testbox
SSLCOMMERZ_STORE_PASS=qwerty

# SMS Gateway
SMS_GATEWAY_PROVIDER=SIMULATED
SMS_SENDER_ID=SmartClinic

# Data Seeding Flag (Set to False in live production)
ALLOW_DEMO_SEED=False
DJANGO_LOG_LEVEL=INFO

# ==============================================================================
# 2. LOCAL DEVELOPMENT CONFIGURATION (SQLITE + LOCALHOST) - COMMENTED OUT
# Uncomment below lines when working locally offline
# ==============================================================================
# DEBUG=True
# SECRET_KEY=django-insecure-change-this-in-production-key-12345
# ALLOWED_HOSTS=localhost,127.0.0.1
#
# # Local SQLite Database
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3
# ALLOW_SQLITE_IN_PROD=True
