# ==============================================================================
# SMART CLINIC BACKEND CONFIGURATION TEMPLATE
# Copy to .env and replace placeholder values with environment-specific secrets.
# NEVER commit the actual .env file with real credentials to version control.
# ==============================================================================

# Core Django Settings
DEBUG=False
SECRET_KEY=replace-with-a-cryptographically-random-50-character-secret-key
ALLOWED_HOSTS=api.yourclinicdomain.com,127.0.0.1

# Database Configuration (PostgreSQL recommended for production)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=smartclinic_prod
DB_USER=smartclinic_user
DB_PASSWORD=replace-with-strong-db-password
DB_HOST=localhost
DB_PORT=5432
ALLOW_SQLITE_IN_PROD=False

# Domains and Cross-Origin Configuration
FRONTEND_URL=https://yourclinicdomain.com
BACKEND_URL=https://api.yourclinicdomain.com
CORS_ALLOWED_ORIGINS=https://yourclinicdomain.com
CSRF_TRUSTED_ORIGINS=https://yourclinicdomain.com

# Production Security Headers
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# Cloudinary Storage (Doctor Avatars & Clinic Documents)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# JWT Token Lifetime
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=1

# SSLCommerz Payment Gateway (Bangladesh)
# In production, set SSLCOMMERZ_IS_SANDBOX=False and provide merchant credentials
SSLCOMMERZ_STORE_ID=your_sslcommerz_store_id
SSLCOMMERZ_STORE_PASS=your_sslcommerz_store_password
SSLCOMMERZ_IS_SANDBOX=True

# Email Delivery (Gmail SMTP / SendGrid / Amazon SES)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@yourclinicdomain.com
EMAIL_HOST_PASSWORD=your_email_app_password
DEFAULT_FROM_EMAIL="Smart Clinic <noreply@yourclinicdomain.com>"

# Bangladesh SMS Gateway (GreenwebBD / BulkSMSBD / Onnorokom / SIMULATED)
SMS_GATEWAY_PROVIDER=GREENWEB_BD
SMS_API_KEY=your_sms_gateway_api_token
SMS_SENDER_ID=SmartClinic
SMS_ENDPOINT_URL=http://api.greenweb.com.bd/api.php

# Logging
DJANGO_LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO

# Demo Seed Safety Guard
# Enable ONLY in approved local/demo environments.
# NEVER set to True on staging or production — the seed command resets ALL user passwords.
# Requires DEBUG=True to also be set. Both conditions must be true for the command to run.
ALLOW_DEMO_SEED=False
