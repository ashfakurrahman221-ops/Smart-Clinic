# ==============================================================================
# SMART CLINIC FRONTEND CONFIGURATION TEMPLATE
# Copy to .env and configure if frontend and backend are hosted on separate domains.
# If hosted behind the same reverse proxy (e.g. Nginx), leave VITE_API_BASE_URL empty
# so that requests route relatively to /api/v1.
# ==============================================================================

# Custom API Base URL (e.g., https://api.yourclinicdomain.com/api/v1)
# Default if omitted: /api/v1 (relative, proxied by Vite dev or Nginx prod)
# VITE_API_BASE_URL=https://api.yourclinicdomain.com/api/v1
